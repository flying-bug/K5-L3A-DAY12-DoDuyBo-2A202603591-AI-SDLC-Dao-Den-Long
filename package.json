{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dao Den Long - 3D lantern game (AI SDLC lab Day 12)",
  "scripts": {
    "start": "node scripts/serve.js",
    "headless": "node src/headless.js",
    "test": "node --test \"tests/*.test.js\"",
    "bench": "node scripts/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --max-semi-space-size=1 scripts/soak.mjs --seed 7 --nights 10 --out soak.json",
    "release": "node scripts/make-release.mjs",
    "leaderboard": "node scripts/serve.js --export-leaderboard leaderboard.json"
  },
  "dependencies": {
    "three": "0.160.0"
  }
}
